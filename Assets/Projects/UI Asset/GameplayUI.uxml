                <ui:Image name="SkillIcon3" source="project://database/Assets/Projects/UI%20Asset/Skill%20Icon.png?fileID=2800000&amp;guid=6d843b07c7ae4194595dac8b0c018af3&amp;type=3#Skill%20Icon" class="skill-icon"/>
                <ui:Image name="SkillIcon4" source="project://database/Assets/Projects/UI%20Asset/Skill%20Icon.png?fileID=2800000&amp;guid=6d843b07c7ae4194595dac8b0c018af3&amp;type=3#Skill%20Icon" class="skill-icon"/>
