                    <ui:Image name="Mark1_Glow" source="project://database/Assets/Projects/UI%20Asset/mark1.png?fileID=2800000&amp;guid=e000b6539e5b6e142a453a83900791c8&amp;type=3#mark1" tint-color="rgb(72, 110, 255)" class="burst-mark burst-mark-glow mark-1"/>
                    <ui:Image name="Mark1" source="project://database/Assets/Projects/UI%20Asset/mark1.png?fileID=2800000&amp;guid=e000b6539e5b6e142a453a83900791c8&amp;type=3#mark1" class="burst-mark mark-1"/>
                    <ui:Image name="Mark2_Glow" source="project://database/Assets/Projects/UI%20Asset/mark2.png?fileID=2800000&amp;guid=5a7da09921e337e4f97de59c6dd3f3aa&amp;type=3#mark2" tint-color="rgb(72, 110, 255)" class="burst-mark burst-mark-glow mark-2"/>
                    <ui:Image name="Mark2" source="project://database/Assets/Projects/UI%20Asset/mark2.png?fileID=2800000&amp;guid=5a7da09921e337e4f97de59c6dd3f3aa&amp;type=3#mark2" class="burst-mark mark-2"/>
                    <ui:Image name="Mark3_Glow" source="project://database/Assets/Projects/UI%20Asset/mark3.png?fileID=2800000&amp;guid=fc12f61fd6298934b935a4d349058b43&amp;type=3#mark3" tint-color="rgb(72, 110, 255)" class="burst-mark burst-mark-glow mark-3"/>
                    <ui:Image name="Mark3" source="project://database/Assets/Projects/UI%20Asset/mark3.png?fileID=2800000&amp;guid=fc12f61fd6298934b935a4d349058b43&amp;type=3#mark3" class="burst-mark mark-3"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="SkillContainer" class="skill-container">
